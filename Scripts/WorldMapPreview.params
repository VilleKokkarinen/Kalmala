# Save this file while Export-WorldMaps.ps1 -Watch is running to refresh the PNGs.
# Preview-only experiments: these values never change gameplay or saved worlds.
# Distances/wavelengths are kilometres. Seeds are unsigned decimal integers.
# Missing settings use current production defaults. Unknown/duplicate keys fail.
WorldSeed=4182
Size=2048
# MasterSeed is optional; omit it to use the production atlas seed.
MasterWavelengthKm=1.55
# Raise threshold for less land; lower it for more land. Allowed: -0.5 through 0.5.
LandThreshold=0.03
BiomeScaleKm=8
WarpStrengthKm=0.08
# Terrain controls (centimetres internally). The full regional height sampler
# consumes Meadows hill/shoulder values; fast biome PNGs only validate/report.
ReliefBroadScaleKm=1
ReliefMiddleScaleKm=0.15
ReliefLocalScaleKm=0.03
MeadowHillScaleM=160
MeadowHillAmplitudeM=6
MeadowShoulderHeightM=10
MeadowShoulderCompressionScaleM=30
MeadowRollingScaleM=45
MeadowRollingAmplitudeM=1.2
MeadowFloorScaleM=12
MeadowFloorAmplitudeM=0.2
StarterRadiusKm=0.5
ElderwoodMinimumKm=1.25
LakesMinimumKm=0.5
MireMinimumKm=4.5
TundraMinimumKm=6
MeadowsMaximumKm=4
LakesMaximumKm=4.5
EligibilityBlendKm=0.05

# Shared wetland placement; Lakes is the starter-distance counterpart of Mire.
MireMaximumKm=14.5
WetlandHumidityMinimum=0.25
WetlandHumidityFull=0.3
WetlandElevationFull=0.75
WetlandElevationMaximum=0.8
WetlandTemperatureMinimum=0
WetlandTemperatureFull=0.1
